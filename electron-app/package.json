{
  "name": "kiri-tts-desktop",
  "version": "1.0.0",
  "description": "Kiri TTS Khmer Voice Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64"
  },
  "keywords": [
    "khmer",
    "tts",
    "kiri",
    "speech",
    "electron"
  ],
  "author": "Sophearith Assistant",
  "license": "MIT",
  "build": {
    "appId": "com.kiritts.desktop",
    "productName": "Kiri TTS Khmer Voice",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "KiriTTS-KhmerVoice-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  }
}
